# Copy to local.properties and set the LAN address of the laptop for a physical phone.
sdk.dir=/home/your-user/Android/Sdk
backend.host=192.168.1.50

# Release endpoints for the Hetzner production deployment.
# Do not use a local IP address here. Release builds require HTTPS/WSS.
backend.release.apiUrl=https://game.example.com/api/
backend.release.wsUrl=wss://game.example.com/ws
